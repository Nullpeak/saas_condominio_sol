# Variables de entorno de GDC. `pipenv run ...` carga este archivo automáticamente.
# NO subir a git (.env ya está en .gitignore).

# Dominio público HTTPS de la app (sin / final). Mercado Pago exige HTTPS.
SITIO_URL=
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------- Mercado Pago (PRODUCCIÓN)
MERCADOPAGO_ENVIRONMENT=production
# Tus integraciones > tu aplicación > Credenciales de producción
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Debe coincidir EXACTO con la "URL de redireccionamiento" de la aplicación:
#   https://TU-DOMINIO/gastos-comunes/mercadopago/callback/
MERCADOPAGO_REDIRECT_URI=
# Tus integraciones > Webhooks > modo productivo, evento "Pagos":
#   https://TU-DOMINIO/gastos-comunes/pagos/mercadopago/notificacion/
MERCADOPAGO_WEBHOOK_URL=
# "Clave secreta" que muestra Mercado Pago al guardar el webhook productivo
MERCADOPAGO_WEBHOOK_SECRET=
# Clave Fernet que cifra los tokens de las cuentas vendedoras en la base de datos.
# Si se cambia o se pierde, hay que volver a conectar todas las cuentas.
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
